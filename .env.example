# =============================================================================
# Perchance AI Toolkit - Environment Configuration
# =============================================================================
# Copy this file to .env and update the values as needed

# =============================================================================
# REQUIRED CONFIGURATION
# =============================================================================

# Groq API Key (Required for AI generation and autonomous features)
# Get your key from: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# =============================================================================
# OPTIONAL CONFIGURATION
# =============================================================================

# Playwright Browser Visibility
# Set to 'false' to see the browser during automation (useful for debugging)
# Set to 'true' to run headless (default for production)
PLAYWRIGHT_HEADLESS=true

# =============================================================================
# NOTES
# =============================================================================
#
# 1. Never commit the actual .env file to version control
# 2. GROQ_API_KEY is required for most CLI commands and all MCP tools
# 3. PLAYWRIGHT_HEADLESS is only needed for 'run' and 'scrape' CLI commands
# 4. No other configuration is needed for the CLI + MCP toolkit
